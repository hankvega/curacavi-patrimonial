<section class="bg-camel-50 border-b-4 border-faded-copper-300">
  <div class="max-w-4xl mx-auto px-4 py-10 md:py-3 flex flex-col md:flex-row items-center justify-center gap-6 md:gap-10 text-center md:text-left">
    <!-- Isotipo -->
    <svg width="110" height="121" viewBox="0 0 100 110" class="shrink-0" aria-hidden="true">
      <circle cx="50" cy="50" r="36" fill="none" stroke="#b3d9a3" stroke-width="20"
        stroke-dasharray="176 50.2" transform="rotate(-40 50 50)" stroke-linecap="butt"/>
      <path d="M40 20 h20 v70 l-10 14 -10 -14 z" fill="#29bdad"/>
      <circle cx="50" cy="58" r="11" fill="#fff2f9"/>
      <circle cx="50" cy="58" r="4.5" fill="#29bdad"/>
    </svg>
    <!-- Texto -->
    <div>
      <h1 class="font-arvo font-black text-5xl md:text-6xl tracking-tight text-pitch-black-900 leading-none">
        CURACAVÍ
      </h1>
      <p class="mt-2 text-sm md:text-base font-bold font-nunito tracking-[0.55em] uppercase text-faded-copper-600 md:pl-1">
        Patrimonial
      </p>
      <p class="mt-4 max-w-md text-sm font-nunito text-pitch-black-900/70">
        Un archivo abierto del patrimonio vivo de Curacaví, Región Metropolitana.
      </p>
    </div>
  </div>
</section>
