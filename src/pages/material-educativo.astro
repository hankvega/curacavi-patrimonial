---
import Base from '../layouts/Base.astro';
import episodes from '../data/episodes.json';
---
<Base title="Material Educativo">
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="font-serif font-black text-4xl mb-4">Material educativo</h1>
    <p class="max-w-2xl text-pitch-black-900/70 mb-12">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Fichas patrimoniales descargables para uso en aulas, entregadas a la Escuela Municipal y el Liceo Polivalente.</p>
    <div class="grid md:grid-cols-3 gap-6">
      {episodes.map(e => (
        <div class="bg-white border-2 border-faded-copper/30 rounded-2xl p-5 hover:shadow-lg transition-shadow flex flex-col">
          <div class="aspect-[3/4] relative rounded-xl overflow-hidden mb-4 bg-pitch-black-950">
            <img src={`/img/episodes/${e.slug}.jpg`} alt={e.title} loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-80"/>
            <span class="absolute bottom-2 left-3 font-serif font-black text-4xl text-camel-100 drop-shadow">{String(e.num).padStart(2,'0')}</span>
          </div>
          <p class="font-serif font-bold">{e.title}</p>
          <p class="text-xs text-pitch-black-900/60 mt-1">Ficha patrimonial · PDF · {e.type}</p>
          <a href={`/episodios/${e.slug}`} class="mt-4 text-sm font-bold text-faded-copper-700 hover:text-crushed-berry-600 transition-colors">Ver ficha →</a>
        </div>
      ))}
    </div>
  </section>
</Base>
