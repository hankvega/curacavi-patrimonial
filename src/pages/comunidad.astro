---
import Base from '../layouts/Base.astro';
const people = [
  ['Nibaldo Arturo Guerra Figueroa', 'Director del proyecto · Editorial Nibaldo Guerra EIRL'],
  ['Miguel Ángel Acosta Quintanilla', 'Desarrollo de recursos digitales'],
  ['Nelda Calderón', 'Directora Museo Coculcom'],
  ['Santiago Daine', 'Chicheria Daine'],
  ['Bordadoras del Puangue', 'Agrupación de mujeres bordadoras'],
  ['Matía Guzmán', 'Director de Academia de danza folclórica Guzmán'],
  ['Héctor Hernandez', 'Director Parque comunitario San Mateo'],
  ['Elías Concha', 'Talabartería Don Elías'],
  ['Cristián Hernández', 'Director Museo del Audio'],
  ['Martín Escobar', 'Propietario Dulcería Doña Isabel'],
  ['Luis Gúmera', 'Cronista de Curacaví'],
  ['Tamara Concha', 'Organización Cuasimodistas de Nuestra Señora del Carmen'],
];
---
<Base title="Comunidad">
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="font-serif font-black text-4xl mb-4">Comunidad asociada</h1>
    <p class="max-w-2xl text-pitch-black-900/70 mb-12">Comunidad asociada. Estas son las personas y agrupaciones que sostienen y transmiten el patrimonio documentado en este archivo. Todas validan su relato y su imagen mediante consentimiento informado antes de la publicación.</p>
    <div class="grid md:grid-cols-3 gap-6">
      {people.map(([name, role]) => (
        <div class="bg-white border-b-8 border-faded-copper rounded-2xl p-6 text-center hover:border-crushed-berry-600 hover:shadow-lg transition-all">
          <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-mahogany-red-900 grid place-items-center font-serif font-black text-2xl text-camel-50">{name.split(' ').map(x => x[0]).slice(0,2).join('')}</div>
          <p class="font-serif font-bold text-lg">{name}</p>
          <p class="text-sm text-pitch-black-900/60 mt-1">{role}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
